{
    "name": "codetraxis",
    "version": "1.0.1",
    "description": "React & React Native debug tool with network inspector, console timeline and live file explorer",
    "keywords": [
        "react debug tool",
        "network inspector",
        "console logger",
        "devtools alternative",
        "axios interceptor",
        "fetch interceptor",
        "debug panel",
        "developer tool",
        "react native debug",
        "expo debug tool",
        "file explorer",
        "console timeline",
        "debug console",
        "local devtools",
        "xhr inspector"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "bin": {
        "codetraxis": "bin/cli.js"
    },
    "main": "server/dist/index.js",
    "files": [
        "bin",
        "server/dist",
        "client/dist",
        "codetraxisAgent"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
        "build:server": "tsc -p server/tsconfig.json",
        "build:client": "vite build --config client/vite.config.ts",
        "build": "npm run build:server && npm run build:client",
        "start": "node server/dist/index.js",
        "codetraxis": "node bin/cli.js ."
    },
    "devDependencies": {
        "concurrently": "^9.0.0",
        "vite": "^6.0.0"
    },
    "dependencies": {
        "get-port": "^7.2.0",
        "open": "^11.0.0",
        "express": "^5.2.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "chokidar": "^5.0.0",
        "ws": "^8.20.0",
        "ignore": "^7.0.5",
        "@babel/parser": "^7.29.2",
        "@babel/types": "^7.29.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Gagik666/codetraxis.git"
    },
    "author": "Gagik Vardanyan",
    "bugs": {
        "url": "https://github.com/Gagik666/codetraxis/issues"
    },
    "homepage": "https://github.com/Gagik666/codetraxis#readme"
}
